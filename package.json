{
  "name": "node-red-contrib-interactive-inject",
  "version": "1.1.0",
  "description": "A Node-RED node with an interactive slider or preset buttons rendered directly on the canvas for one-click value injection — no dashboard required",
  "main": "dist/interactive-inject.js",
  "files": [
    "dist/interactive-inject.js",
    "dist/interactive-inject.html",
    "examples/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && html-minifier-terser src/interactive-inject.html -o dist/interactive-inject.html --collapse-whitespace --remove-comments --minify-js true",
    "watch": "tsc --watch",
    "test": "jest --forceExit",
    "prepublishOnly": "npm run build"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "interactive-inject": "dist/interactive-inject.js"
    },
    "examples": "examples"
  },
  "keywords": [
    "node-red",
    "inject",
    "slider",
    "preset",
    "buttons",
    "interactive",
    "canvas",
    "victron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dirkjanfaber/node-red-contrib-interactive-inject.git"
  },
  "bugs": {
    "url": "https://github.com/dirkjanfaber/node-red-contrib-interactive-inject/issues"
  },
  "homepage": "https://github.com/dirkjanfaber/node-red-contrib-interactive-inject#readme",
  "author": "Dirk-Jan Faber",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.7.0",
    "@types/node-red": "^1.3.4",
    "html-minifier-terser": "^7.2.0",
    "jest": "^30.4.2",
    "node-red": "^4.1.10",
    "node-red-node-test-helper": "^0.3.4",
    "ts-jest": "^29.1.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "node-red": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "node-red": {
      "optional": true
    }
  },
  "overrides": {
    "typescript": "^6.0.3"
  }
}
